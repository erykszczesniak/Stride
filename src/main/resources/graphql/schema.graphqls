type Query {
    # User queries
    user(id: ID!): User
    users(page: Int, size: Int): [User]
    currentUser: User

    # Activity queries
    activity(id: ID!): Activity
    activities(userId: ID, page: Int, size: Int): [Activity]
    feedActivities(page: Int, size: Int): [Activity]
    activityStats(userId: ID!): ActivityStats
    weeklyStats(userId: ID!): WeeklyStats

    # Goal queries
    goals(userId: ID!): [Goal]
    activeGoals(userId: ID!): [Goal]

    # Event queries
    event(id: ID!): Event
    upcomingEvents(page: Int, size: Int): [Event]
    userEvents(userId: ID!): [Event]

    # Challenge queries
    challenge(id: ID!): Challenge
    activeChallenges(page: Int, size: Int): [Challenge]
    userChallenges(userId: ID!): [Challenge]

    # Club queries
    club(id: ID!): Club
    clubs(page: Int, size: Int): [Club]
    userClubs(userId: ID!): [Club]

    # Dashboard
    dashboard: Dashboard
}

type Mutation {
    # Activity mutations
    createActivity(input: ActivityInput!): Activity
    updateActivity(id: ID!, input: ActivityInput!): Activity
    deleteActivity(id: ID!): Boolean
    likeActivity(id: ID!): Activity
    unlikeActivity(id: ID!): Activity
    addComment(activityId: ID!, content: String!): Comment

    # Goal mutations
    createGoal(input: GoalInput!): Goal
    updateGoal(id: ID!, input: GoalInput!): Goal
    deleteGoal(id: ID!): Boolean

    # User mutations
    updateProfile(input: UpdateUserInput!): User
    followUser(userId: ID!): Boolean
    unfollowUser(userId: ID!): Boolean

    # Event mutations
    registerForEvent(eventId: ID!): Boolean
    unregisterFromEvent(eventId: ID!): Boolean

    # Challenge mutations
    joinChallenge(challengeId: ID!): Boolean
    leaveChallenge(challengeId: ID!): Boolean

    # Club mutations
    joinClub(clubId: ID!): Boolean
    leaveClub(clubId: ID!): Boolean
}

type User {
    id: ID!
    firstName: String!
    lastName: String!
    email: String
    avatar: String
    bio: String
    city: String
    country: String
    createdAt: String
    followersCount: Int
    followingCount: Int
    activitiesCount: Int
}

type Activity {
    id: ID!
    title: String!
    description: String
    activityType: ActivityType!
    distance: Float!
    duration: Int!
    elevationGain: Int
    calories: Int
    averageSpeed: Float
    maxSpeed: Float
    averageHeartRate: Int
    maxHeartRate: Int
    startTime: String!
    endTime: String
    startLocation: String
    endLocation: String
    routePolyline: String
    isPrivate: Boolean
    likesCount: Int
    commentsCount: Int
    likedByCurrentUser: Boolean
    createdAt: String
    user: User!
    comments: [Comment]
}

type Comment {
    id: ID!
    content: String!
    createdAt: String!
    user: User!
}

type Goal {
    id: ID!
    goalType: GoalType!
    period: GoalPeriod!
    activityType: ActivityType
    targetValue: Float!
    currentValue: Float
    progressPercentage: Float
    remainingValue: Float
    startDate: String!
    endDate: String!
    isActive: Boolean
    isCompleted: Boolean
}

type Event {
    id: ID!
    name: String!
    description: String
    coverImage: String
    activityType: ActivityType
    eventDate: String!
    location: String!
    city: String
    distance: Float
    registeredCount: Int
    maxParticipants: Int
    isRegistered: Boolean
    isPublic: Boolean
}

type Challenge {
    id: ID!
    name: String!
    description: String
    coverImage: String
    challengeType: ChallengeType!
    activityType: ActivityType
    targetValue: Float!
    startDate: String!
    endDate: String!
    participantsCount: Int
    isParticipating: Boolean
    isActive: Boolean
    isPublic: Boolean
    userProgress: Float
}

type Club {
    id: ID!
    name: String!
    description: String
    coverImage: String
    profileImage: String
    city: String
    country: String
    sportType: ActivityType
    membersCount: Int
    isMember: Boolean
    isPrivate: Boolean
    owner: User!
}

type ActivityStats {
    totalDistance: Float
    totalDuration: Int
    totalCalories: Int
    totalActivities: Int
    totalElevationGain: Int
    averageDistance: Float
    averageDuration: Float
    trendPercentage: String
}

type WeeklyStats {
    totalDistance: Float
    trendPercentage: String
    dailyStats: [DailyStats]
}

type DailyStats {
    dayName: String
    distance: Float
    duration: Int
    activities: Int
}

type Dashboard {
    user: User
    stats: ActivityStats
    weeklyStats: WeeklyStats
    recentActivities: [Activity]
    weeklyGoal: Goal
    upcomingEvents: [Event]
}

# Enums
enum ActivityType {
    RUN
    RIDE
    SWIM
    WALK
    HIKE
    ALPINE_SKI
    BACKCOUNTRY_SKI
    CROSSFIT
    ELLIPTICAL
    ICE_SKATE
    INLINE_SKATE
    KAYAKING
    KITESURF
    NORDIC_SKI
    ROCK_CLIMBING
    ROLLER_SKI
    ROWING
    SNOWBOARD
    SNOWSHOE
    STAIR_STEPPER
    STAND_UP_PADDLING
    SURFING
    VIRTUAL_RIDE
    VIRTUAL_RUN
    WEIGHT_TRAINING
    WINDSURF
    WORKOUT
    YOGA
    OTHER
}

enum GoalType {
    DISTANCE
    TIME
    ACTIVITIES
    ELEVATION
}

enum GoalPeriod {
    WEEKLY
    MONTHLY
    YEARLY
}

enum ChallengeType {
    DISTANCE
    TIME
    ELEVATION
    ACTIVITIES_COUNT
    SEGMENT
}

# Input types
input ActivityInput {
    title: String!
    description: String
    activityType: ActivityType!
    distance: Float!
    duration: Int!
    elevationGain: Int
    calories: Int
    averageSpeed: Float
    maxSpeed: Float
    averageHeartRate: Int
    maxHeartRate: Int
    startTime: String!
    startLocation: String
    endLocation: String
    routePolyline: String
    isPrivate: Boolean
}

input GoalInput {
    goalType: GoalType!
    period: GoalPeriod!
    activityType: ActivityType
    targetValue: Float!
}

input UpdateUserInput {
    firstName: String!
    lastName: String!
    bio: String
    city: String
    country: String
}
