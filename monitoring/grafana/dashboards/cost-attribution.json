{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    { "title": "How the model works", "type": "link", "url": "https://github.com/erykszczesniak/Stride/blob/microservices/docs/cost-attribution.md", "targetBlank": true }
  ],
  "panels": [
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "title": "Infrastructure — modelled from CPU consumed and memory reserved", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Modelled hourly infrastructure cost (cores × 0.04 USD + reserved GiB × 0.005 USD) stacked by team. Recording rule cost:team_infra_usd:rate1h; attribution comes from the team tag every service sets in Config Server.",
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 30, "stacking": { "mode": "normal" }, "spanNulls": false } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull"] } },
      "title": "Infra cost per hour by team",
      "type": "timeseries",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (team) (cost:team_infra_usd:rate1h{team=~\"$team\"})", "legendFormat": "{{team}}", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Modelled hourly infrastructure cost monolith (cost:infra_usd:rate1h). Sorted by the current value; the service at the top is where a cost review starts.",
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "color": { "mode": "continuous-GrYlRd" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "sizing": "auto" },
      "title": "Infra cost per hour by service",
      "type": "bargauge",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sort_desc(cost:infra_usd:rate1h{team=~\"$team\",app=~\"$app\"})", "legendFormat": "{{app}}", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Cores actually consumed monolith, five-minute average (process_cpu_usage × system_cpu_count). A service climbing here without a traffic increase is the InfraCostSpike alert's usual cause.",
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false } } },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "CPU cores consumed by service",
      "type": "timeseries",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "cost:cpu_cores:avg5m{team=~\"$team\",app=~\"$app\"}", "legendFormat": "{{app}}", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Memory reserved monolith in GiB, derived from the JVM heap max ÷ 0.75 (MaxRAMPercentage). Reserved memory is what a bill charges for, whether or not the heap is used.",
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false } } },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Memory reserved (GiB) by service",
      "type": "timeseries",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "cost:memory_gib:reserved{team=~\"$team\",app=~\"$app\"}", "legendFormat": "{{app}}", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "30-day projection at the current rate: modelled infra cost per hour × 720 plus AI provider spend over the trailing hour × 720. A planning number, not an invoice.",
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } } },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "title": "Projected 30-day spend (infra + AI)",
      "type": "stat",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(cost:infra_usd:rate1h) * 720", "legendFormat": "infra", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum(cost:ai_usd:rate1h) * 720", "legendFormat": "ai", "refId": "B" }
      ]
    },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }, "id": 101, "title": "AI providers — real spend from token usage", "type": "row" },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Provider spend per trailing hour by model, from ai_request_cost_usd_total (tokens × the price table in ai-service). The AiSpendHigh alert fires above 5 USD/hour.",
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 30, "stacking": { "mode": "normal" }, "spanNulls": false }, "thresholdsStyle": { "mode": "line" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "red", "value": 5 } ] } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "lastNotNull"] } },
      "title": "AI spend per hour by model (red line = 5 USD alert)",
      "type": "timeseries",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "cost:ai_usd:rate1h", "legendFormat": "{{provider}}/{{model}}", "refId": "A" } ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Tokens per second by provider and direction (ai_tokens_total). Input tokens growing faster than requests means the prompt is getting longer (recent-history block); output tokens track reply length.",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "spanNulls": false } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] } },
      "title": "Tokens per second by provider and direction",
      "type": "timeseries",
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (provider, direction) (rate(ai_tokens_total[$__rate_interval]))", "legendFormat": "{{provider}} {{direction}}", "refId": "A" } ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["stride", "cost", "finops"],
  "templating": {
    "list": [
      { "name": "datasource", "label": "Data source", "type": "datasource", "query": "prometheus", "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" }, "hide": 0, "refresh": 1 },
      { "name": "team", "label": "Team", "type": "query", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "definition": "label_values(cost:infra_usd:rate1h, team)", "query": { "query": "label_values(cost:infra_usd:rate1h, team)", "refId": "team" }, "includeAll": true, "multi": true, "allValue": ".*", "refresh": 2, "sort": 1, "current": { "selected": true, "text": ["All"], "value": ["$__all"] } },
      { "name": "app", "label": "Service", "type": "query", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "definition": "label_values(cost:infra_usd:rate1h{team=~\"$team\"}, app)", "query": { "query": "label_values(cost:infra_usd:rate1h{team=~\"$team\"}, app)", "refId": "app" }, "includeAll": true, "multi": true, "allValue": ".*", "refresh": 2, "sort": 1, "current": { "selected": true, "text": ["All"], "value": ["$__all"] } }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Stride — Cost attribution",
  "uid": "stride-cost",
  "version": 1
}
