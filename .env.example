# ============================================
# Stride Microservices — Environment Variables
# ============================================
# Copy to .env and adjust. Most have sensible defaults for local dev.

# ============================================
# Security
# ============================================
# Shared HS256 secret. MUST be the same across gateway and all services
# that issue/validate JWTs. Minimum 32 characters.
JWT_SECRET=dev-secret-min-32-chars-this-is-only-for-development-do-not-use-in-prod

# ============================================
# Databases (per-service Postgres)
# ============================================
POSTGRES_PASSWORD=stride

# ============================================
# External APIs
# ============================================
# Groq — goal/plan generation (ai-service)
GROQ_API_KEY=
# Anthropic — per-activity AI chat (ai-service); chat answers 503 when unset
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Google sign-in (user-service)
GOOGLE_CLIENT_ID=
# Strava — login provider (user-service) + activity import (activity-service)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_STATE_SECRET=

# ============================================
# Email (SMTP) — used by notification-service
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ============================================
# Frontend
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
