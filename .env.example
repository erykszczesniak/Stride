# ============================================
# Stride Microservices — Environment Variables
# ============================================
# Copy to .env and adjust. Most have sensible defaults for local dev.

# ============================================
# Security
# ============================================
# Shared HS256 secret. MUST be the same across gateway and all services
# that issue/validate JWTs. Minimum 32 characters.
JWT_SECRET=dev-secret-min-32-chars-this-is-only-for-development-do-not-use-in-prod

# ============================================
# Databases (per-service Postgres)
# ============================================
POSTGRES_PASSWORD=stride

# ============================================
# External APIs
# ============================================
GROQ_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ============================================
# Email (SMTP) — used by notification-service
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ============================================
# Frontend
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
