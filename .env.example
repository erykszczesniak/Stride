# ============================================
# Strava Clone - Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# Database (PostgreSQL)
# ============================================
POSTGRES_DB=strava
POSTGRES_USER=strava
POSTGRES_PASSWORD=your_secure_password_here

# ============================================
# Spring Boot
# ============================================
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=your_jwt_secret_here_min_32_characters

# ============================================
# CORS
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ============================================
# External APIs
# ============================================
GROQ_API_KEY=your_groq_api_key_here
# Anthropic key for the activity chat (unset => chat answers via Groq failover, or 503 if both are unset)
ANTHROPIC_API_KEY=
# AI guardrails (defaults shown): per-user limits per minute, prompt guard, PII masking, chat failover
AI_CHAT_PER_MINUTE=10
AI_GENERATION_PER_MINUTE=5
AI_GUARD_ENABLED=true
AI_PII_MASKING_ENABLED=true
AI_CHAT_FAILOVER_ENABLED=true

# ============================================
# Email (SMTP)
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# ============================================
# Docker Registry (for production)
# ============================================
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_BACKEND=your-username/strava-backend
DOCKER_IMAGE_FRONTEND=your-username/strava-frontend
VERSION=latest
